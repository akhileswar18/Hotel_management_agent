# HMS Phase 1 Environment Configuration
# Copy this file to .env and update values as needed

# Database
DATABASE_URL=sqlite:///./hms.db

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# API Server
API_HOST=127.0.0.1
API_PORT=8000

# Printer (disabled for Phase 1)
PRINTER_ENABLED=false

# Offline Mode (default: always offline, sync later)
OFFLINE_MODE=true

# Application
APP_NAME=Hotel Management System
TAX_RATE=0.18
CURRENCY=INR
