# HMS Phase 1 Environment Configuration
# Copy this file to .env and update values as needed

# Database
DATABASE_URL=sqlite:///./hms.db

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# API Server
API_HOST=127.0.0.1
API_PORT=8000

# Printer (disabled for Phase 1)
PRINTER_ENABLED=false

# Offline Mode (default: always offline, sync later)
OFFLINE_MODE=true

# Application
APP_NAME=Hotel Management System
TAX_RATE=0.18
CURRENCY=INR

# LLM Configuration (InsightAgent + IntentParser — optional)
# Supported providers: ollama (local, default), groq (cloud, fast), openai
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=8

# For Groq (recommended — free tier, fast):
GROQ_API_KEY=gsk_...

# For OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# For Ollama (local, no key needed):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2
