# HMS Phase 1 Environment Configuration
# Copy this file to .env and update values as needed

# Database
DATABASE_URL=sqlite:///./hms.db

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# API Server
API_HOST=127.0.0.1
API_PORT=8000

# Printer (disabled for Phase 1)
PRINTER_ENABLED=false

# Offline Mode (default: always offline, sync later)
OFFLINE_MODE=true

# Application
APP_NAME=Hotel Management System
TAX_RATE=0.18
CURRENCY=INR

# LLM Configuration (InsightAgent - optional)
LLM_PROVIDER=ollama
LLM_MODEL=llama3:8b
LLM_TIMEOUT=5
OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...  # Only if LLM_PROVIDER=openai
